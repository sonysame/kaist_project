# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)

# Google AI Studio (https://aistudio.google.com/apikey) 에서 무료로 발급
GEMINI_API_KEY=

# 필요하면 모델을 바꿀 수 있어요
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite

# Supabase 대시보드 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
